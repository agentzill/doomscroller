# Instagram app ID/secret from: Use cases > Instagram API > API setup with Instagram login
# (NOT the Meta app ID/secret from App settings > Basic)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Public base URL of this deployment, no trailing slash.
# The redirect URI registered in Instagram must be exactly: ${APP_URL}/api/auth/callback
APP_URL=https://your-app.vercel.app

# Supabase (used in the next phase: rooms + realtime)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
